# =============================================
# IKIGAI CLOTHES - Frontend (Vite)
# Copiá este archivo como .env.local y completá los valores.
# =============================================

# Supabase (obligatorio)
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu_anon_key

# Mercado Pago - Public Key (producción, solo para el frontend)
VITE_MERCADOPAGO_PUBLIC_KEY=APP_USR-xxxx

# EnvíoPack (reemplaza a Zippin / Zipnova)
# La API Key NO va en el frontend: la usan las Edge Functions de Supabase
# (ver supabase/functions/.env). VITE_ENVIOPACK_API_KEY se deja como referencia.
VITE_ENVIOPACK_API_KEY=

# Código postal de despacho del local (origen), va como metadata de la cotización
# y se guarda con la orden. La Edge Function usa ENVIOPACK_ORIGEN_CP (server-side,
# default 3360); esta variable es solo metadata del lado del frontend.
# Se sigue aceptando la vieja VITE_ZIPPIN_ORIGIN_CP por compatibilidad.
VITE_ENVIOPACK_ORIGEN_CP=