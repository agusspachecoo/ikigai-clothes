# =============================================
# IKIGAI CLOTHES - Edge Functions (server-side)
# Copiá este archivo como supabase/functions/.env
# NO commitees el .env real.
# =============================================

# Supabase (en producción los inyecta la plataforma)
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=tu_anon_key
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key

# URL pública de la tienda (back_urls de Mercado Pago)
STORE_URL=http://localhost:5173

# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxx

# Firma HMAC de las cotizaciones de envío. Mínimo 32 caracteres.
# Generá uno con: openssl rand -base64 48
SHIPPING_QUOTE_SECRET=cambia-este-valor-por-uno-aleatorio-de-32-o-mas

# MiCorreo / Correo Argentino (opcional: sin estas, cotizar-envio usa el
# tarifario local de respaldo)
CORREO_ARGENTINO_USER=
CORREO_ARGENTINO_PASS=
CORREO_ARGENTINO_CUSTOMER_ID=
CORREO_ARGENTINO_CP_ORIGEN=3360
